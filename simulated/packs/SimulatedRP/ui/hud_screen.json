{
  "namespace": "hud",

  "chat_label": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "view",
          "source_property_name": "(not (('%.10s' * #text) = 'bob.toast;'))",
          "target_property_name": "#visible"
        }
      }
    ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "toast_panel@hud.toasty": {}
          }
        ]
      },
      {
        "array_name": "controls",
        "operation": "replace",
        "control_name": "hud_actionbar_text_area",
        "value": [
          {
            "hud_actionbar_text_area": {
              "type": "panel",
              "factory": {
                "name": "hud_actionbar_text_factory",
                "control_ids": {
                  "hud_actionbar_text": "hud_actionbar_text@hud.simulated_hud_actionbar_text"
                }
              }
            }
          }
        ]
      }
    ]
  }
}
